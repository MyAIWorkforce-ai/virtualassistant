//How it works
import data from '../data/howItWorks.json';

export default function HowItWorks() {
  const { title, subtitle, steps } = data.section;

  return (
    <section className="how-it-works">
      <h2>{title}</h2>
      <p>{subtitle}</p>
      <div className="steps-container">
        {steps.map((step) => (
          <div key={step.stepNumber} className="step-card">
            <div className={`icon ${step.icon}`} />
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            <div className="step-number">{step.stepNumber}</div>
          </div>
        ))}
      </div>
    </section>
  );
}

// Pricing 
"use client";
import { useState } from "react";
import data from "../data/pricing.json";

export default function Pricing() {
  const { title, subtitle, billingOptions, plans } = data.section;
  const [billingCycle, setBillingCycle] = useState("monthly");

  return (
    <section className="pricing-section">
      <h2>{title}</h2>
      <p>{subtitle}</p>

      {/* Billing Toggle */}
      <div className="billing-toggle">
        <button
          className={billingCycle === "monthly" ? "active" : ""}
          onClick={() => setBillingCycle("monthly")}
        >
          {billingOptions.monthlyLabel}
        </button>
        <button
          className={billingCycle === "yearly" ? "active" : ""}
          onClick={() => setBillingCycle("yearly")}
        >
          {billingOptions.yearlyLabel}
          <span className="discount">{billingOptions.yearlyDiscountText}</span>
        </button>
      </div>

      {/* Plans */}
      <div className="plans-container">
        {plans.map((plan) => (
          <div
            key={plan.name}
            className={`plan-card ${plan.mostPopular ? "popular" : ""}`}
          >
            {plan.mostPopular && <span className="badge">Most Popular</span>}
            <h3>{plan.name}</h3>
            <p className="tagline">{plan.tagline}</p>
            <p className="price">
              ${billingCycle === "monthly" ? plan.monthlyPrice : plan.yearlyPrice}
              <span>/month</span>
            </p>

            <ul className="features">
              {plan.features.map((feature, i) => (
                <li key={i}>✅ {feature}</li>
              ))}
            </ul>

            <a href={plan.cta.link} className="btn-primary">
              {plan.cta.text}
            </a>
          </div>
        ))}
      </div>
    </section>
  );
}
